# Example pathset config for zsh's fpath (config name: fpath).
#
# Copy to:
#   ~/.config/pathset/fpath       (canonical)
#
# Then add to your zshrc — fpath is an array, so split the colon-joined
# output back into list elements:
#
#   fpath=( $(pathset -f fpath -q -s) $fpath )
#
# $VAR reads the environment, not your shell's own parameters. ZSH_VERSION is
# the one that bites here: zsh sets it but never exports it, so pathset cannot
# see it. Export it for the call if you use the versioned entry below:
#
#   fpath=( $(ZSH_VERSION="$ZSH_VERSION" pathset -f fpath -q -s) $fpath )
#
# Syntax is identical to the path config — see `pathset -h`.

# --- User function dirs ---------------------------------------------------
?~/.zsh/functions
?~/.config/zsh/functions

# --- Homebrew zsh completions / functions ---------------------------------
?$HOMEBREW_PREFIX/share/zsh/site-functions

# --- System ---------------------------------------------------------------
/usr/share/zsh/site-functions

# The functions zsh itself ships, under a version-numbered directory. Drops
# silently unless ZSH_VERSION reaches pathset's environment — see the header.
?/usr/share/zsh/$ZSH_VERSION/functions
